# Free AI Gateway — nginx reverse-proxy example
# Author: Mourad Soltani — © 2026 Mourad Soltani Technologies™ @MST
upstream free_ai_gateway {
    server 127.0.0.1:4000 max_fails=2 fail_timeout=10s;
    keepalive 32;
}

limit_req_zone $binary_remote_addr zone=fag_rl:10m rate=10r/s;

server {
    listen 443 ssl http2;
    server_name api.example.com;

    ssl_certificate     /etc/letsencrypt/live/api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 2m;
    proxy_read_timeout   120s;

    location / {
        limit_req zone=fag_rl burst=20 nodelay;
        proxy_pass         http://free_ai_gateway;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";
        proxy_buffering    off;
        proxy_cache        off;
    }

    location = /metrics {
        allow 10.0.0.0/8;
        deny  all;
        proxy_pass http://free_ai_gateway;
    }
}

server {
    listen 80;
    server_name api.example.com;
    return 301 https://$host$request_uri;
}
